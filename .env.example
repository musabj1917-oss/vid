# Copy to .env locally, or add as GitHub Secrets for the cloud workflow.
# Never commit a real .env (it is gitignored).

# Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Supabase service_role key (Dashboard -> Settings -> API -> service_role)
# Required for CI uploads + job logging. Keep secret!
SUPABASE_SERVICE_KEY=
# Storage bucket for videos (default: videos)
SUPABASE_BUCKET=videos
